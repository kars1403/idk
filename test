-- CHUYỂN GUI BẰNG RIGHT SHIFT
-- 1: Fly Menu
-- 2: Status GUI
-- 3: Ẩn cả hai
-- =====================================================

local menuCycle = 0

local function cycleMenus()
    menuCycle = (menuCycle % 3) + 1

    guiFrame.Visible = (menuCycle == 1)
    statusFrame.Visible = (menuCycle == 2)
end

-- =====================================================
-- INPUT CHUNG
-- =====================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    local key = input.KeyCode

    -- Right Ctrl: GUI tọa độ
    if key == Enum.KeyCode.RightControl then
        teleportFrame.Visible = not teleportFrame.Visible
        return
    end

    -- Right Shift: luân phiên hai GUI
    if key == Enum.KeyCode.RightShift then
        cycleMenus()
        return
    end

    -- Left Ctrl: đổi bộ phím chung
    if key == Enum.KeyCode.LeftControl then
        keySet = (keySet == 1) and 2 or 1
        return
    end

    -- Left Alt + R/E/T/V/C: bật/tắt riêng chức năng
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) then
        for _, action in ipairs(actions) do
            if key == originalKeys[action] then
                remapped[action] = not remapped[action]
                return
            end
        end
    end

    if gameProcessed then return end

    -- Xử lý chức năng
    -- Khi keySet = 2, Delete ưu tiên R > V > C > E > T.
    for _, action in ipairs(actions) do
        local activeKey = getKey(action)

        if activeKey and key == activeKey then
            if action == "R" then
                if flying then
                    stopFlying()
                else
                    startFlying()
                end

            elseif action == "V" then
                teleportCharacter()

            elseif action == "C" then
                teleportToMouse()

            elseif action == "E" then
                if not following then
                    currentTarget = getClosestPlayerInSight()

                    if currentTarget then
                        following = true
                    end
                else
                    following = false
                    currentTarget = nil
                end

            elseif action == "T" then
                setNoclip(not noclipEnabled)
            end

            break
        end
    end

    updateInfo()
    updateStatus()
end)

