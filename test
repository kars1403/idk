-- =====================================================
-- KEY REMAP
-- Left Ctrl: chuyển chế độ chung
-- Left Alt + R/E/T/V/C: tắt/bật riêng chức năng tương ứng
-- =====================================================

local keySet = 1

local actions = {"R", "V", "C", "E", "T"}

local originalKeys = {
    R = Enum.KeyCode.R,
    V = Enum.KeyCode.V,
    C = Enum.KeyCode.C,
    E = Enum.KeyCode.E,
    T = Enum.KeyCode.T
}

-- true = chức năng tạm thời bị vô hiệu hóa
local remapped = {
    R = false,
    V = false,
    C = false,
    E = false,
    T = false
}

local function isActionEnabled(action)
    return not remapped[action]
end

local function getKey(action)
    if not isActionEnabled(action) then
        return nil
    end

    if keySet == 2 then
        return Enum.KeyCode.Delete
    end

    return originalKeys[action]
end

