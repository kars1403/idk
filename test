local function updateStatus()
    local states = {
        R = flying,
        E = following,
        T = noclipEnabled
    }

    for action, isOn in pairs(states) do
        local row = statusRows[action]

        if row then
            local color

            if isOn then
                color = Color3.fromRGB(40, 255, 90)
                row.state.Text = "ON"
            else
                color = Color3.fromRGB(255, 55, 65)
                row.state.Text = "OFF"
            end

            row.dot.BackgroundColor3 = color
            row.glow.Color = color
            row.state.TextColor3 = color
        end
    end
end

