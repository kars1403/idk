local originalCameraMaxZoom = player.CameraMaxZoomDistance
local originalCameraMinZoom = player.CameraMinZoomDistance
player.CameraMaxZoomDistance = 1e9
player.CameraMinZoomDistance = 0.5

local bg
local bv
local flyConn

local function stopFlying()
    flying = false

    if flyConn then
        flyConn:Disconnect()
        flyConn = nil
    end

    if bg then
        bg:Destroy()
        bg = nil
    end

    if bv then
        bv:Destroy()
        bv = nil
    end
end

local function startFlying()
    if flying or false then
        return
    end

    local character, hrp = getCharacter()
    flying = true

    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 10000
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp

    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    flyConn = RunService.RenderStepped:Connect(function()
        if not flying or not bg or not bv then
            return
        end

        if not hrp.Parent then
            stopFlying()
            return
        end

        local camera = workspace.CurrentCamera
        if camera then
            bg.CFrame = camera.CFrame
            bv.Velocity = camera.CFrame.LookVector * flySpeed
        end
    end)
end

