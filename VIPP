-- INPUT CHUNG
-- =====================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    local key = input.KeyCode

    -- Interface hotkeys
    if key == Enum.KeyCode.RightControl then
        teleportFrame.Visible = not teleportFrame.Visible
        return
    end

    if key == Enum.KeyCode.RightShift then
        cycleMenus()
        return
    end

    if UserInputService:GetFocusedTextBox() then
        return
    end

    for _, action in ipairs(actions) do
        local activeKey = getKey(action)

        if activeKey and key == activeKey then
            if action == "R" then
                if flying then
                    stopFlying()
                else
                    startFlying()
                end

            elseif action == "V" then
                teleportCharacter()

            elseif action == "C" then
                teleportToMouse()

            elseif action == "E" then
                if not following then
                    currentTarget = getClosestPlayerInSight()
                    if currentTarget then
                        following = true
                    end
                else
                    following = false
                    currentTarget = nil
                end

            elseif action == "T" then
                setNoclip(not noclipEnabled)
            end

            break
        end
    end

    updateStatus()
end)

-- =====================================================
-- CLEANUP WHEN GUI IS REMOVED / SCRIPT ENDS
-- =====================================================

if typeof(script) == "Instance" then
script.Destroying:Connect(function()
    stopFlying()

    if followConn then
        followConn:Disconnect()
    end

    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end

    restoreCollision()

    player.CameraMaxZoomDistance = originalCameraMaxZoom
    player.CameraMinZoomDistance = originalCameraMinZoom
end)
end

