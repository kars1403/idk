-- FOLLOW
-- =====================================================

local function getClosestPlayerInSight()
    local camera = workspace.CurrentCamera
    if not camera then
        return nil
    end

    local closestPlayer = nil
    local smallestAngle = math.huge

    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player
            and otherPlayer.Character
            and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then

            local hrp = otherPlayer.Character.HumanoidRootPart
            local direction = hrp.Position - camera.CFrame.Position

            if direction.Magnitude > 0 then
                local dot = math.clamp(
                    camera.CFrame.LookVector:Dot(direction.Unit),
                    -1,
                    1
                )
                local angle = math.acos(dot)

                if angle < math.rad(30) and angle < smallestAngle then
                    smallestAngle = angle
                    closestPlayer = otherPlayer
                end
            end
        end
    end

    return closestPlayer
end

local followConn
followConn = RunService.RenderStepped:Connect(function()
    if false or not following or not currentTarget then
        return
    end

    local targetCharacter = currentTarget.Character
    local myCharacter = player.Character

    local targetHRP = targetCharacter
        and targetCharacter:FindFirstChild("HumanoidRootPart")
    local myHRP = myCharacter
        and myCharacter:FindFirstChild("HumanoidRootPart")

    if not targetHRP then
        following = false
        currentTarget = nil
        return
    end

    if myHRP then
        local offset = -targetHRP.CFrame.LookVector * followDistance
        local newPos = targetHRP.Position + offset
        myHRP.CFrame = CFrame.new(newPos, targetHRP.Position)
    end
end)

