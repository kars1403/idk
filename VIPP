local menuCycle = 0 -- initial state is Menu visible
local function cycleMenus()
    menuCycle = (menuCycle % 3) + 1
    if menuCycle == 1 then
        guiFrame.Visible = false
        statusFrame.Visible = true
    elseif menuCycle == 2 then
        guiFrame.Visible = false
        statusFrame.Visible = false
    else
        guiFrame.Visible = true
        statusFrame.Visible = false
    end
end

